<script>
// ── ISD codes ──
var ISD_CODES=[{c:"India",d:"+91"},{c:"USA",d:"+1"},{c:"UK",d:"+44"},{c:"UAE",d:"+971"},{c:"Australia",d:"+61"},{c:"Canada",d:"+1"},{c:"Singapore",d:"+65"},{c:"Malaysia",d:"+60"},{c:"Germany",d:"+49"},{c:"France",d:"+33"},{c:"South Africa",d:"+27"},{c:"Kenya",d:"+254"},{c:"Nigeria",d:"+234"},{c:"Bangladesh",d:"+880"},{c:"Sri Lanka",d:"+94"},{c:"Nepal",d:"+977"},{c:"Pakistan",d:"+92"},{c:"Indonesia",d:"+62"},{c:"Philippines",d:"+63"},{c:"Japan",d:"+81"},{c:"China",d:"+86"},{c:"Brazil",d:"+55"},{c:"Mexico",d:"+52"},{c:"Other",d:"+00"}];
var COUNTRIES=["Afghanistan","Albania","Algeria","Argentina","Australia","Austria","Azerbaijan","Bahrain","Bangladesh","Belgium","Brazil","Canada","Chile","China","Colombia","Croatia","Czech Republic","Denmark","Egypt","Estonia","Ethiopia","Finland","France","Germany","Ghana","Greece","Hungary","India","Indonesia","Iran","Iraq","Ireland","Israel","Italy","Japan","Jordan","Kazakhstan","Kenya","Kuwait","Latvia","Lebanon","Lithuania","Malaysia","Maldives","Mexico","Morocco","Mozambique","Myanmar","Nepal","Netherlands","New Zealand","Nigeria","Norway","Oman","Pakistan","Palestine","Peru","Philippines","Poland","Portugal","Qatar","Romania","Russia","Saudi Arabia","Senegal","Singapore","Slovakia","South Africa","South Korea","Spain","Sri Lanka","Sweden","Switzerland","Tanzania","Thailand","Tunisia","Turkey","Uganda","Ukraine","United Arab Emirates","United Kingdom","United States","Uzbekistan","Venezuela","Vietnam","Yemen","Zimbabwe","Other"];

function populateSelect(id,items,labelFn,valFn){
  var s=document.getElementById(id);
  items.forEach(function(it){var o=document.createElement('option');o.value=valFn(it);o.textContent=labelFn(it);s.appendChild(o)});
}
populateSelect('whatsappIsd',ISD_CODES,function(x){return x.d+' '+x.c},function(x){return x.d});
populateSelect('country',COUNTRIES,function(x){return x},function(x){return x});

// Set India default for ISD
document.getElementById('whatsappIsd').value='+91';

// ── Radio select ──
function selectRadio(el,name){
  document.querySelectorAll('[onclick*="'+name+'"]').forEach(function(b){b.classList.remove('selected')});
  el.classList.add('selected');
  el.querySelector('input').checked=true;
  document.getElementById('instTypeError').style.display='none';
}

// ── Validation helpers ──
function required(id){
  var g=document.getElementById(id).closest('.field-group');
  var v=document.getElementById(id).value.trim();
  if(!v){g.classList.add('has-error');return false}
  g.classList.remove('has-error');return true;
}
function requiredSelect(id){
  var g=document.getElementById(id).closest('.field-group');
  var v=document.getElementById(id).value;
  if(!v){g.classList.add('has-error');return false}
  g.classList.remove('has-error');return true;
}

// ── Submit ──
function submitForm(){
  var ok=true;
  ok=required('firstName')&&ok;
  ok=required('fullName')&&ok;

  // email validation
  var emailVal=document.getElementById('email').value.trim();
  var emailGroup=document.getElementById('email').closest('.field-group');
  var emailRe=/^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if(!emailVal||!emailRe.test(emailVal)){emailGroup.classList.add('has-error');ok=false;}
  else emailGroup.classList.remove('has-error');

  ok=requiredSelect('age')&&ok;
  ok=requiredSelect('country')&&ok;
  ok=requiredSelect('studyYear')&&ok;
  ok=required('specialization')&&ok;
  ok=required('institution')&&ok;
  ok=required('hodName')&&ok;

  var instType=document.querySelector('input[name="instType"]:checked');
  if(!instType){document.getElementById('instTypeError').style.display='block';ok=false;}

  var wp=document.getElementById('whatsapp').value.trim();
  var wpGroup=document.getElementById('whatsapp').closest('.field-group');
  if(!wp){
    wpGroup.classList.add('has-error');
    document.getElementById('whatsappError').style.display='block';
    ok=false;
  } else {
    wpGroup.classList.remove('has-error');
    document.getElementById('whatsappError').style.display='none';
  }

  if(!ok){
    document.querySelector('.has-error').scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }

  var btn=document.getElementById('submitBtn');
  btn.classList.add('loading');btn.disabled=true;

  var payload={
    timestamp: new Date().toISOString(),
    firstName: document.getElementById('firstName').value.trim(),
    fullName: document.getElementById('fullName').value.trim(),
    email: document.getElementById('email').value.trim(),
    age: document.getElementById('age').value,
    country: document.getElementById('country').value,
    studyYear: document.getElementById('studyYear').value,
    specialization: document.getElementById('specialization').value.trim(),
    institution: document.getElementById('institution').value.trim(),
    institutionType: instType ? instType.value : '',
    hodName: document.getElementById('hodName').value.trim(),
    whatsapp: document.getElementById('whatsappIsd').value + ' ' + document.getElementById('whatsapp').value.trim()
  };

  // ── Replace with your deployed Apps Script Web App URL ──
  var SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbx4ciSru-FQsH2Gl0dYPrGhhdW2fet0ocHowoz4_dVWlWNbgwky0uZtEajcROr57UUoww/exec';

  fetch(SCRIPT_URL, {
    method:'POST',
    body: JSON.stringify(payload)
  })
  .then(function(r){return r.json()})
  .then(function(data){
    btn.classList.remove('loading');btn.disabled=false;
    if(data.status==='ok'){
      document.getElementById('formCard').style.display='none';
      document.getElementById('successBox').classList.add('show');
      window.scrollTo({top:0,behavior:'smooth'});
    } else {
      alert('Submission failed. Please try again.');
    }
  })
  .catch(function(){
    btn.classList.remove('loading');btn.disabled=false;
    alert('Network error. Please check your connection and try again.');
  });
}
</script>

